\item \code{S[t] = k * S[t-1] + (cop[t] * P[t] + B[t] + U[t] - heat_demand[t]) * dt}
\item \verb{Tcap * SOCmin/100 <= S[t] <= Tcap * SOCmax/100}
\item \verb{0 <= P[t] <= Pc}, and \code{P[t] = 0} where \code{cop[t] = 0}
\item \verb{0 <= B[t] <= Pb}, also where \code{cop[t] = 0}
\item \code{U[t] >= 0}
